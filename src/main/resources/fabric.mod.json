		"main": [
			"maihatsuu.archive.Archive"
		],
		"client": [
			"maihatsuu.archive.client.ArchiveClient"
		],
		"modmenu": [
			"maihatsuu.archive.client.ArchiveModMenu"
		]
	},
	"mixins": [
		"archive.mixins.json",
		{
			"config": "archive.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~1.21.1",
